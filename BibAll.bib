@book{Forster2021IPCCAR6Ch7,
	edition = {1},
	title = {Climate {Change} 2021 – {The} {Physical} {Science} {Basis}: {Working} {Group} {I} {Contribution} to the {Sixth} {Assessment} {Report} of the {Intergovernmental} {Panel} on {Climate} {Change}},
